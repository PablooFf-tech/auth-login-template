# ─── Auth.js (obligatorio) ────────────────────────────────
# Genera uno nuevo: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# ─── Google ───────────────────────────────────────────────
# Guía: README.md → "Guía: Google OAuth"
# Console: https://console.cloud.google.com/apis/credentials
# Redirect: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── Apple ────────────────────────────────────────────────
# Guía: README.md → "Guía: Apple Sign In"
# Developer: https://developer.apple.com/account/resources/identifiers/list
# Redirect: {AUTH_URL}/api/auth/callback/apple
# AUTH_APPLE_SECRET = JWT firmado con tu .p8 (válido ~180 días)
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# ─── GitHub ───────────────────────────────────────────────
# Guía: README.md → "Guía: GitHub OAuth"
# https://github.com/settings/developers
# Callback: {AUTH_URL}/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ─── Discord ──────────────────────────────────────────────
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# ─── Facebook / Meta ──────────────────────────────────────
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# ─── X (Twitter) ──────────────────────────────────────────
AUTH_TWITTER_ID=
AUTH_TWITTER_SECRET=

# ─── LinkedIn ─────────────────────────────────────────────
AUTH_LINKEDIN_ID=
AUTH_LINKEDIN_SECRET=

# ─── Spotify ──────────────────────────────────────────────
AUTH_SPOTIFY_ID=
AUTH_SPOTIFY_SECRET=

# ─── Twitch ───────────────────────────────────────────────
AUTH_TWITCH_ID=
AUTH_TWITCH_SECRET=

# ─── Reddit ───────────────────────────────────────────────
AUTH_REDDIT_ID=
AUTH_REDDIT_SECRET=

# ─── Microsoft Entra ID ───────────────────────────────────
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# ─── Email magic link (opcional) ──────────────────────────
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM="YourApp <noreply@your-domain.com>"
